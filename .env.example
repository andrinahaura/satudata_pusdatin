# true  = pakai data simulasi di browser (src/js/data/mock.js), tanpa backend
# false = ambil data dari backend di VITE_API_BASE_URL
VITE_USE_MOCK=true

# Base URL REST API backend (lihat README bagian "Kontrak API")
VITE_API_BASE_URL=/api

# Opsional: WebSocket realtime. Kosong = polling tiap VITE_POLL_INTERVAL ms
VITE_WS_URL=
VITE_POLL_INTERVAL=5000

VITE_BUILDING_NAME=Gedung Pusdatin
